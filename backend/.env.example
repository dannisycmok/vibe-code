PORT=5001

# Supabase PostgreSQL connection string (Dashboard -> Connect -> Session pooler).
# This is a server-only secret. Never expose it in the frontend or commit it.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Path to the built React application. Relative paths are resolved from the backend folder.
FRONTEND_DIST=../frontend/dist
# Comma-separated list of allowed browser origins. localhost origins are always allowed in development.
CORS_ORIGIN=http://localhost:5174
